[report]
exclude_also =
    no cover: start(.|\n)*?no cover: stop
    def __repr__
    if __name__ == .__main__.:

omit =
    # omit anything in a .local directory anywhere
    */.local/*
    # omit everything in /tests
    /**/test_*.py
    /sbom_graph_model/*

[run]
omit =
    # omit anything in a .local directory anywhere
    */.local/*
    # omit everything in /tests
    /**/test_*.py